# syntax=docker/dockerfile:1.6
# Experimental 3090/4090 profile for driver-550 hosts: CUDA 12.4 base,
# PyTorch cu126 via minor-version compatibility. GPU tests remain required.
# Both app venvs inherit ONE system PyTorch/CUDA installation.
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget git ca-certificates build-essential \
        python3 python3-venv python3-dev python3-pip \
        libgl1 libglib2.0-0 libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

COPY toolkit/torch-constraints.txt /opt/toolkit/torch-constraints.txt
ENV PIP_CONSTRAINT=/opt/toolkit/torch-constraints.txt \
    PIP_FIND_LINKS="https://download.pytorch.org/whl/cu126/torch/ https://download.pytorch.org/whl/cu126/torchvision/ https://download.pytorch.org/whl/cu126/torchaudio/ https://download.pytorch.org/whl/cu126/torchcodec/"

RUN python3 -m pip install --upgrade pip wheel setuptools \
    && python3 -m pip install torch==2.13.0+cu126 torchvision==0.28.0+cu126 torchaudio==2.11.0+cu126 \
        --index-url https://download.pytorch.org/whl/cu126

ARG TORCH_ARCH_LIST="8.6 8.9"
ARG SAGE_REF=d1a57a546c3d395b1ffcbeecc66d81db76f3b4b5
RUN git init /tmp/SageAttention \
    && cd /tmp/SageAttention \
    && git remote add origin https://github.com/thu-ml/SageAttention.git \
    && git fetch --depth=1 origin "${SAGE_REF}" \
    && git checkout --detach FETCH_HEAD \
    && TORCH_EXT=$(python3 -c 'import torch.utils.cpp_extension; print(torch.utils.cpp_extension.__file__)') \
    && cp "$TORCH_EXT" "${TORCH_EXT}.bak" \
    && sed -i 's/raise RuntimeError(CUDA_MISMATCH_MESSAGE/pass #raise RuntimeError(CUDA_MISMATCH_MESSAGE/' "$TORCH_EXT" \
    && sed -i 's/"-fopenmp", //; s/"-lgomp", //' setup.py \
    # Same serial CUDA-12.4 build workaround as the existing ComfyUI image.
    && EXT_PARALLEL=1 TORCH_CUDA_ARCH_LIST="${TORCH_ARCH_LIST}" python3 -m pip install --no-build-isolation --no-deps . \
    && mv "${TORCH_EXT}.bak" "$TORCH_EXT" \
    && rm -rf /tmp/SageAttention

COPY toolkit/comfy-constraints.txt /opt/toolkit/comfy-constraints.txt
ENV PIP_CONSTRAINT=/opt/toolkit/comfy-constraints.txt
ARG COMFY_REF=7a131a3afadc8200120f67f9236311a2c48b7445
RUN git init /root/ComfyUI \
    && cd /root/ComfyUI \
    && git remote add origin https://github.com/Comfy-Org/ComfyUI.git \
    && git fetch --depth=1 origin "${COMFY_REF}" \
    && git checkout --detach FETCH_HEAD \
    && python3 -m venv --system-site-packages venv \
    && venv/bin/python -m pip install --upgrade pip wheel setuptools \
    && venv/bin/python -m pip install -r requirements.txt transformers==4.57.6 av==16.0.1 \
        tiktoken sentencepiece requests websocket-client

# Conservative defaults for this old-driver profile. Explicit CLI flags still
# select other attention backends or --enable-dynamic-vram on a capable host.
RUN python3 - <<'PY'
from pathlib import Path
path = Path('/root/ComfyUI/comfy/cli_args.py')
text = path.read_text()
needle = 'if comfy.options.args_parsing:'
assert text.count(needle) == 1
path.write_text(text.replace(needle, 'parser.set_defaults(disable_dynamic_vram=True, use_pytorch_cross_attention=True)\n\n' + needle))
PY

COPY custom_nodes.txt /tmp/custom_nodes.txt
WORKDIR /root/ComfyUI/custom_nodes
# ponytail: reuse existing catalog heads; pin node commits if reproducibility is needed.
RUN set -e; \
    while read -r url dir; do \
        case "$url" in ''|\#*) continue ;; esac; \
        [ -n "$dir" ] || dir=$(basename "$url" .git); \
        git clone --depth=1 "$url" "$dir" || exit 1; \
    done < /tmp/custom_nodes.txt
# This node later migrated to AlbumentationsX, which conflicts with the
# Albumentations/albucore pair used by AdvancedLivePortrait in the same venv.
ARG CONTROLNET_AUX_REF=59b1fc411ede8623b2997855b8018f0b3b6cf49f
RUN cd comfyui_controlnet_aux \
    && git fetch --depth=1 origin "${CONTROLNET_AUX_REF}" \
    && git checkout --detach FETCH_HEAD
RUN sed -i 's/from comfy.ldm.chroma.layers import DoubleStreamBlock, SingleStreamBlock/from comfy.ldm.flux.layers import DoubleStreamBlock, SingleStreamBlock/' ComfyUI-NAG/chroma/layers.py \
    && sed -i 's/from comfy.ldm.chroma.layers import/from comfy.ldm.flux.layers import/' ComfyUI-NAG/chroma/model.py
RUN . /root/ComfyUI/venv/bin/activate; \
    for d in */; do \
        if [ -f "$d/requirements.txt" ]; then pip install -r "$d/requirements.txt" || echo "WARNING: requirements failed for $d"; fi; \
        if [ -f "$d/install.py" ]; then python3 "$d/install.py" || echo "WARNING: install.py failed for $d"; fi; \
    done; \
    python3 -m pip check

# Toolkit has its own Albumentations/protobuf requirements, so retain only
# shared GPU constraints for this environment.
ENV PIP_CONSTRAINT=/opt/toolkit/torch-constraints.txt
ARG TOOLKIT_REF=b69b98314557f7c8b08e11bbb14e48d959e6ab26
RUN git init /root/ai-toolkit \
    && cd /root/ai-toolkit \
    && git remote add origin https://github.com/ostris/ai-toolkit.git \
    && git fetch --depth=1 origin "${TOOLKIT_REF}" \
    && git checkout --detach FETCH_HEAD \
    && git submodule update --init --recursive --depth=1 \
    && python3 -m venv --system-site-packages venv \
    && venv/bin/python -m pip install --upgrade pip wheel setuptools \
    && venv/bin/python -m pip install -r requirements.txt torchcodec==0.15.0+cu126 \
    && venv/bin/python -m pip check

WORKDIR /root/ai-toolkit
# Use the upstream portable Node/FFmpeg provisioners, not the GPU-detecting
# installer. No driver/GPU is present during the GitHub Actions image build.
RUN python3 -c 'from manager import nodejs,ffmpeg,env; d={"os":"linux","arch":"x86_64"}; nodejs.ensure_node(d); ffmpeg.ensure_ffmpeg(d); env.write_sitecustomize(); nodejs.ensure_ui_deps()'
ENV PATH=/root/ai-toolkit/.node/bin:/root/ai-toolkit/.ffmpeg/bin:${PATH} \
    LD_LIBRARY_PATH=/root/ai-toolkit/.ffmpeg/lib:${LD_LIBRARY_PATH} \
    NEXT_TELEMETRY_DISABLED=1

# Private UI; retain upstream streaming file server. Existing Clore startup
# calls build_and_start, so make that command launch the prebuilt UI only.
RUN python3 - <<'PY'
import json
from pathlib import Path
path = Path('ui/cron/fileServer.ts')
text = path.read_text()
needle = 'server.listen(publicPort);'
assert text.count(needle) == 1
path.write_text(text.replace(needle, "server.listen(publicPort, '127.0.0.1');"))
path = Path('ui/package.json')
data = json.loads(path.read_text())
data['scripts']['build_and_start'] = 'npm run start'
path.write_text(json.dumps(data, indent=2) + '\n')
PY

WORKDIR /root/ai-toolkit/ui
# sqlite3's prebuilt addon needs newer glibc than Ubuntu 22.04: build locally.
RUN npm rebuild sqlite3 --build-from-source --foreground-scripts \
    && npm run update_db \
    && npm run build

RUN find /root/ComfyUI /root/ai-toolkit -type d -name .git -prune -exec rm -rf {} + \
    && find /root/ComfyUI /root/ai-toolkit -type d -name __pycache__ -prune -exec rm -rf {} + \
    && rm -rf /root/.cache /root/.npm /tmp/*

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS toolkit
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python \
    PIP_CONSTRAINT=/opt/toolkit/torch-constraints.txt \
    PIP_FIND_LINKS="https://download.pytorch.org/whl/cu126/torch/ https://download.pytorch.org/whl/cu126/torchvision/ https://download.pytorch.org/whl/cu126/torchaudio/ https://download.pytorch.org/whl/cu126/torchcodec/" \
    PATH=/root/ai-toolkit/.node/bin:/root/ai-toolkit/.ffmpeg/bin:${PATH} \
    LD_LIBRARY_PATH=/root/ai-toolkit/.ffmpeg/lib:${LD_LIBRARY_PATH} \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget git ca-certificates gnupg \
        python3 python3-venv python3-dev python3-pip build-essential \
        libgl1 libglib2.0-0 libgles2 libegl1 aria2 rclone tmux \
        fonts-dejavu-core fonts-liberation vim \
        openssh-server openssh-client htop nano xauth lsb-release systemd systemd-sysv \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /root/ComfyUI /root/ComfyUI
COPY --from=builder /root/ai-toolkit /root/ai-toolkit
COPY toolkit /opt/toolkit
WORKDIR /root
